{
  "name": "tripnest-ticket-booking",
  "version": "2.0.0",
  "description": "Full-stack Redbus-style travel ticket booking web application with React 19, Express, SQLite, live seat holding, e-ticket generation, GPS bus tracking, and admin dashboard.",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node backend/server.js",
    "predev": "npm run build",
    "build": "npm run build:frontend",
    "build:frontend": "vite build --config frontend/vite.config.js",
    "test:smoke": "node backend/scripts/test-smoke.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@next/env": "^16.4.5",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "next": "^16.4.5",
    "prisma": "^8.0.0-rc.30",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "vite": "8.3.6"
  }
}
